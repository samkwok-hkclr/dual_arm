<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="mdh_to_origin" params="a d alpha theta">
    <xacro:property name="c_alpha" value="${cos(alpha)}"/>
    <xacro:property name="s_alpha" value="${sin(alpha)}"/>
    <xacro:property name="c_theta" value="${cos(theta)}"/>
    <xacro:property name="s_theta" value="${sin(theta)}"/>

    <!-- Calculate translation -->
    <!-- Translation in local frame after R_z(theta) and T_z(d) is [a, 0, d] -->
    <!-- Then rotate by R_x(alpha) -->
    <xacro:property name="x" value="${a * 1 + 0 * 0 + d * 0}"/>  <!-- a*cos(0) + 0*cos(alpha)? Actually R_x(alpha) * [a,0,d] -->
    <xacro:property name="y" value="${a * 0 + 0 * c_alpha + d * -s_alpha}"/>
    <xacro:property name="z" value="${a * 0 + 0 * s_alpha + d * c_alpha}"/>
    
    <!-- Calculate rotation matrix from R_x(alpha) * R_z(theta) -->
    <xacro:property name="r00" value="${c_theta}"/>
    <xacro:property name="r01" value="${-s_theta}"/>
    <xacro:property name="r02" value="${0}"/>
    <xacro:property name="r10" value="${c_alpha * s_theta}"/>
    <xacro:property name="r11" value="${c_alpha * c_theta}"/>
    <xacro:property name="r12" value="${-s_alpha}"/>
    <xacro:property name="r20" value="${s_alpha * s_theta}"/>
    <xacro:property name="r21" value="${s_alpha * c_theta}"/>
    <xacro:property name="r22" value="${c_alpha}"/>
    
    <!-- Convert rotation matrix to RPY (fixed-axis XYZ) -->
    <!-- There are singularities at pitch = +-pi/2. We need to handle the general case. -->
    <!-- Check for gimbal lock by checking if r20^2 is close to 1 -->
    <xacro:property name="eps" value="1e-12"/>
    <xacro:property name="r20_sq" value="${r20 * r20}"/>
    
    <!-- If 1 - r20^2 > eps, then no gimbal lock -->
    <xacro:if value="${1 - r20_sq &gt; eps}">
      <!-- General case: no gimbal lock -->
      <xacro:property name="pitch" value="${atan2(-r20, sqrt(r00*r00 + r10*r10))}"/>
      <xacro:property name="roll" value="${atan2(r21, r22)}"/>
      <xacro:property name="yaw" value="${atan2(r10, r00)}"/>
    </xacro:if>
    <xacro:unless value="${1 - r20_sq &gt; eps}">
      <!-- Gimbal lock case: pitch = +-pi/2 -->
      <xacro:property name="pitch" value="${atan2(-r20, 0)}"/>
      <xacro:property name="roll" value="${0}"/>
      <xacro:property name="yaw" value="${atan2(-r01, r11)}"/>
    </xacro:unless>
    
    <!-- Output the origin transform -->
    <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
  </xacro:macro>

  <xacro:macro name="dual_arm" params="name parent *origin">

    <xacro:property name="M_PI" value="3.14159265359" />
    <xacro:property name="M_PI_2" value="1.57079632679" />  

    <xacro:property name="left_alpha_1" value="${-90.000000 * M_PI / 180}" />
    <xacro:property name="left_alpha_2" value="${-90.005000 * M_PI / 180}" />
    <xacro:property name="left_alpha_3" value="${90.048000 * M_PI / 180}" />
    <xacro:property name="left_alpha_4" value="${-90.037000 * M_PI / 180}" />
    <xacro:property name="left_alpha_5" value="${89.920000 * M_PI / 180}" />
    <xacro:property name="left_alpha_6" value="${-89.729000 * M_PI / 180}" />
    <xacro:property name="left_alpha_7" value="${90.087000 * M_PI / 180}" />

    <xacro:property name="left_a_1" value="${0.000000 / 1000}" />
    <xacro:property name="left_a_2" value="${0.026000 / 1000}" />
    <xacro:property name="left_a_3" value="${0.063000 / 1000}" />
    <xacro:property name="left_a_4" value="${38.590000 / 1000}" />
    <xacro:property name="left_a_5" value="${0.055000 / 1000}" />
    <xacro:property name="left_a_6" value="${0.171000 / 1000}" />
    <xacro:property name="left_a_7" value="${66.305000 / 1000}" />

    <xacro:property name="left_theta_1" value="${90.022000 * M_PI / 180}" />
    <xacro:property name="left_theta_2" value="${0.334000 * M_PI / 180}" />
    <xacro:property name="left_theta_3" value="${0.171000 * M_PI / 180}" />
    <xacro:property name="left_theta_4" value="${-0.469000 * M_PI / 180}" />
    <xacro:property name="left_theta_5" value="${0.684000 * M_PI / 180}" />
    <xacro:property name="left_theta_6" value="${-91.261000 * M_PI / 180}" />
    <xacro:property name="left_theta_7" value="${-0.851000 * M_PI / 180}" />

    <xacro:property name="left_d_1" value="${209.000000 / 1000}" />
    <xacro:property name="left_d_2" value="${-0.126000 / 1000}" />
    <xacro:property name="left_d_3" value="${310.064000 / 1000}" />
    <xacro:property name="left_d_4" value="${0.176000 / 1000}" />
    <xacro:property name="left_d_5" value="${310.425000 / 1000}" />
    <xacro:property name="left_d_6" value="${0.366000 / 1000}" />
    <xacro:property name="left_d_7" value="${-1.004000 / 1000}" />

    <xacro:property name="right_alpha_1" value="${-90.000000 * M_PI / 180}" />
    <xacro:property name="right_alpha_2" value="${90.060000 * M_PI / 180}" />
    <xacro:property name="right_alpha_3" value="${-90.065000 * M_PI / 180}" />
    <xacro:property name="right_alpha_4" value="${90.053000 * M_PI / 180}" />
    <xacro:property name="right_alpha_5" value="${-89.968000 * M_PI / 180}" />
    <xacro:property name="right_alpha_6" value="${90.541000 * M_PI / 180}" />
    <xacro:property name="right_alpha_7" value="${-89.977000 * M_PI / 180}" />

    <xacro:property name="right_a_1" value="${0.000000 / 1000}" />
    <xacro:property name="right_a_2" value="${0.075000 / 1000}" />
    <xacro:property name="right_a_3" value="${-0.255000 / 1000}" />
    <xacro:property name="right_a_4" value="${38.818000 / 1000}" />
    <xacro:property name="right_a_5" value="${0.833000 / 1000}" />
    <xacro:property name="right_a_6" value="${-0.198000 / 1000}" />
    <xacro:property name="right_a_7" value="${68.070000 / 1000}" />

    <xacro:property name="right_theta_1" value="${90.000000 * M_PI / 180}" />
    <xacro:property name="right_theta_2" value="${0.161000 * M_PI / 180}" />
    <xacro:property name="right_theta_3" value="${0.386000 * M_PI / 180}" />
    <xacro:property name="right_theta_4" value="${0.202000 * M_PI / 180}" />
    <xacro:property name="right_theta_5" value="${0.062000 * M_PI / 180}" />
    <xacro:property name="right_theta_6" value="${-89.345000 * M_PI / 180}" />
    <xacro:property name="right_theta_7" value="${-0.200000 * M_PI / 180}" />

    <xacro:property name="right_d_1" value="${-209.000000 / 1000}" />
    <xacro:property name="right_d_2" value="${0.161000 / 1000}" />
